{
  "name": "car-or-driver",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Francesco Braicovich",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francescobraicovich/car-or-driver.git"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "description": "Formula 1 driver and car ratings: the website and its reproducible data pipeline",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "build": "node tools/build-pages.mjs",
    "build:model": "node tools/build-model.mjs && node tools/build-teammate-graph.mjs",
    "build:data": "node tools/build-model.mjs && node tools/build-teammate-graph.mjs && node tools/build-race-laps.mjs && node tools/build-tracks.mjs",
    "research:findings": "node packages/research/node/export-ratings-table.mjs tmp/findings && python3 packages/research/python/compute-findings.py tmp/findings",
    "build:findings": "node packages/research/node/export-ratings-table.mjs tmp/findings && python3 packages/research/python/compute-findings.py tmp/findings",
    "test": "node tests/run-all.mjs",
    "test:golden": "node tests/golden.mjs",
    "test:browser": "node tests/smoke-browser.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check:publication": "node tools/check-publication.mjs",
    "evaluate": "node research/stable-ratings/evaluate.mjs",
    "research:compare-models": "node packages/research/node/compare-models.mjs",
    "research:legacy-evaluate": "node packages/research/node/evaluate.mjs",
    "verify:exam": "node packages/research/node/verify-exam-invariance.mjs",
    "research:state-space-calibrate": "node packages/research/node/state-space-calibrate.mjs",
    "research:state-space-fit": "node packages/research/node/state-space-fit.mjs",
    "research:backbone": "node packages/research/node/search-backbone.mjs",
    "research:backbone:quick": "node packages/research/node/search-backbone.mjs --evals 300",
    "research:gate": "node packages/research/node/gate-backbone.mjs research/evaluation/backbone/search.json",
    "research:suite": "node packages/research/node/suite.mjs",
    "research:diagnose": "node packages/research/node/diagnose.mjs",
    "research:heads-metrics": "node packages/research/node/heads-metrics.mjs",
    "research:rane-benchmark": "node research/benchmarks/rane-benchmark.mjs",
    "research:literature-benchmark": "node research/benchmarks/literature-benchmark.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
